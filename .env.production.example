# Production environment for Moogo.
#
# Copy to /etc/moogo/moogo.env, chmod 640, owned root:moogo.
#
#   sudo install -m 0640 -o root -g moogo /dev/null /etc/moogo/moogo.env
#   sudo editor /etc/moogo/moogo.env
#
# Then check it before starting anything:
#
#   sudo -u moogo bash -c 'set -a; . /etc/moogo/moogo.env; set +a; \
#     /usr/local/bin/moogo --check-config'
#
# The service will refuse to start on an incomplete file, which is deliberate:
# booting into a configuration that cannot verify an account is worse than not
# booting.
#
# Every value containing a space must be quoted: this file is sourced by both
# moogo-backup and the check above, and an unquoted value becomes several
# arguments.

# --- Required ---

MOOGO_DATABASE_URL=postgres://moogo:CHANGE_ME@127.0.0.1:5432/moogo?sslmode=disable

# openssl rand -base64 32
# Must be at least 32 characters, and must NOT be the value dev.sh defaults to:
# that one is published in this repository, and production refuses it.
MOOGO_SESSION_SECRET=

# --- Required in production ---

MOOGO_ENV=production

# The app only sets Secure cookies when this is true, and configuration refuses
# production without it. Behind a proxy, TLS terminates in Caddy, so this is not
# optional merely because the app itself sees plain HTTP.
MOOGO_COOKIE_SECURE=true

# The origin people actually type. Confirmation and password-reset links are
# built from it, so a wrong value here sends every one of them nowhere useful.
MOOGO_PUBLIC_URL=https://moogo.example.com

# The single writable path. ProtectSystem=strict makes the rest of the
# filesystem read-only for the service, and systemd allows writes only here.
MOOGO_DATA_DIR=/var/lib/moogo

# --- At least one of these two, or the service will not start ---

# Transactional email, from Resend. Needed for the address confirmation that
# registration sends, and for password resets.
RESEND_API_KEY=

# OR Google sign-in. This satisfies the same requirement: UpsertUserByEmail sets
# email_verified_at and keeps it on conflict, so an account registered by
# password can still be opened through Google.
MOOGO_GOOGLE_CLIENT_ID=
MOOGO_GOOGLE_CLIENT_SECRET=

# With RESEND_API_KEY set, the address confirmation and reset email go out as
# from this, and the provider has to be allowed to send for it.
#
# Quoted because it contains a space and angle brackets: the backup cron entry
# sources this file, and an unquoted value would be parsed as separate words.
MOOGO_MAIL_FROM="Moogo <noreply@moogo.example.com>"

# --- Set this when running behind a proxy ---

# Without it, X-Forwarded-For is ignored and every request appears to come from
# 127.0.0.1. The per-client rate limit then counts all visitors as one client,
# which turns the limit on /auth/login into a limit on your whole user base.
MOOGO_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Everything below has a working default. Listed so the knobs are discoverable,
# not because they need setting on a first deployment.

# MOOGO_ADDR=:8080                      must be a loopback address behind Caddy
# MOOGO_SESSION_TTL=24h
# MOOGO_DB_MAX_CONNS=8
# MOOGO_DB_MIN_CONNS=2
# MOOGO_QUERY_TIMEOUT=30s
# MOOGO_READ_TIMEOUT=15s
# MOOGO_IDLE_TIMEOUT=120s
# MOOGO_MAX_BODY_BYTES=1MB              JSON request cap
# MOOGO_MAX_OBJECT_BYTES=268435456      one upload; matches the 256 MB product cap
# MOOGO_MAX_STORAGE_BYTES=268435456     per project; above this is rejected
# MOOGO_MAX_DB_BYTES=104857600          per project
# MOOGO_DEFAULT_MAX_PROJECTS=2
# MOOGO_DEFAULT_MAX_DB_BYTES=104857600
# MOOGO_DEFAULT_MAX_STORAGE_BYTES=268435456
# MOOGO_PASSWORD_RESET_TTL=1h
# MOOGO_VERIFICATION_TTL=24h
# MOOGO_ACTIVITY_LOG_RETENTION_DAYS=90
# MOOGO_BACKUP_DIR=/var/backups/moogo   read by moogo-backup, not by the service