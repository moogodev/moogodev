{
  "name": "@moogodev/client",
  "version": "0.2.3",
  "description": "Official JavaScript/TypeScript client for Moogo object storage",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && tsc -m ESNext --outDir dist/esm && mv dist/esm/index.js dist/index.mjs",
    "dev": "tsc -w",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "moogo",
    "object-storage",
    "s3-compatible",
    "bucket"
  ],
  "author": "Moogo Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moogodev/moogodev.git",
    "directory": "clients/js"
  },
  "bugs": {
    "url": "https://github.com/moogodev/moogodev/issues"
  },
  "homepage": "https://moogo.dev/docs/javascript-client",
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
