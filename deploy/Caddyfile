# Caddy in front of Moogo.
#
# The binary speaks plain HTTP and only calls ListenAndServe, so TLS has to
# terminate here. Caddy obtains and renews the certificate on its own.
#
# Replace moogo.example.com with your domain before installing.

moogo.example.com {
	encode zstd gzip

	# Everything goes to the same origin, including /healthz and /readyz, which
	# systemd and any external monitor poll. The application sets its own
	# security headers on all of them.
	#
	# Caddy sets X-Forwarded-For itself, and the application's RealIP middleware
	# trusts it only for addresses listed in MOOGO_TRUSTED_PROXIES. That list
	# must therefore contain 127.0.0.1, or every client collapses into one
	# address and the per-client rate limit stops counting clients.
	reverse_proxy 127.0.0.1:8080

	# HSTS is set here rather than relied on from the application. The app only
	# adds it when r.TLS != nil, and behind a terminating proxy r.TLS is always
	# nil -- so without this line the deployment sends no HSTS at all.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	log {
		output file /var/log/caddy/moogo.log {
			roll_size 20MiB
			roll_keep 10
		}
		format json
	}
}

# Plain HTTP exists only to redirect. Serving the site over it would put every
# session cookie and every secret key on the wire in clear.
http://moogo.example.com {
	redir https://{host}{uri} permanent
}