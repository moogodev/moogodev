# Example environment for Moogo. Copy to .env and fill in real values.
#
#   cp .env.example .env
#
# Every value has a safe default except the ones marked REQUIRED. Real
# environment variables always win over this file.

# --- Required -----------------------------------------------------------

# Postgres connection string for the control plane.
MOOGO_DATABASE_URL=postgres://user:pass@localhost:5432/moogo?sslmode=disable

# Secret used to sign session cookies. At least 32 characters.
MOOGO_SESSION_SECRET=change-me-to-a-long-random-string

# --- Google OAuth (optional) -------------------------------------------

# Both are required to show the "Continue with Google" button. With neither set
# the button stays hidden and email/password is the only way in.
#
# To create them: Google Cloud Console -> pick a project -> APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID -> Application type:
# "Web application".
#
# Then set the Authorized redirect URI to exactly:
#     <MOOGO_PUBLIC_URL>/auth/google/callback
# It has to match character for character, including http vs https and any
# port. A mismatch comes back as Google's redirect_uri_mismatch error.
MOOGO_GOOGLE_CLIENT_ID=
MOOGO_GOOGLE_CLIENT_SECRET=

# --- Resend (transactional email) ---------------------------------------

# Resend API key. Leave empty to log emails to the console instead of sending.
# Both message kinds -- address confirmation and password reset -- go out
# through this one key.
RESEND_API_KEY=

# The "From" address for outgoing mail.
#
# IMPORTANT: with the default onboarding sender, Resend only delivers to the
# email address on the Resend account itself and rejects every other recipient
# with a 403. To send to real users you have to verify a domain in Resend
# (resend.com/domains, add the DNS records it gives you) and then point this at
# an address on that domain, e.g. "Moogo <no-reply@moogo.dev>".
MOOGO_MAIL_FROM=Moogo <onboarding@resend.dev>

# How long a password-reset link stays valid.
MOOGO_PASSWORD_RESET_TTL=1h

# How long an address-confirmation link stays valid. Deliberately longer than
# the reset TTL: a confirmation is read right after registering, whereas a
# reset link can sit in an inbox for days.
MOOGO_VERIFICATION_TTL=24h

# --- Optional overrides -------------------------------------------------

# Reverse proxies whose X-Forwarded-For, X-Real-IP and True-Client-IP headers
# are believed, as a comma-separated list of addresses.
#
# Set this when the service sits behind Caddy, nginx or a load balancer. Without
# it every request appears to come from the proxy, so the sign-in rate limit
# treats all visitors as a single caller and one person can lock everyone out.
#
# It is trusted exactly as written. A client cannot pick its own identity by
# sending these headers unless its address is listed here, so do not put
# 0.0.0.0 or :: in it -- that is the same as trusting everybody.
# MOOGO_TRUSTED_PROXIES=127.0.0.1,::1

# MOOGO_ADDR=:8080
# MOOGO_PUBLIC_URL=http://localhost:8080
#
# Where client applications are told to send their queries and their storage
# requests: the base of MOOGO_PROJECT_URL and MOOGO_BUCKET_ENDPOINT. Defaults to
# MOOGO_PUBLIC_URL, which is what a single-host deployment wants. Set it only
# when the data plane lives on a hostname of its own.
# MOOGO_API_URL=http://localhost:8080
#
# The origin published objects are served from: the base of an object's
# public_url. Defaults to MOOGO_API_URL, which is what a deployment with no
# separate CDN host wants. Set it to a host that only serves /pub/ when public
# objects should be cached and served apart from the data plane.
# MOOGO_CDN_URL=https://cdn.example.com
# MOOGO_ENV=development
# MOOGO_COOKIE_SECURE=false

# --- Database backups (optional) ----------------------------------------

# Off-site copies of every project's SQLite database, written to an
# S3-compatible bucket. The intended target is Cloudflare R2.
#
# This is off by default. Turn it on with MOOGO_BACKUP_ENABLED=true and then
# set MOOGO_BACKUP_ENDPOINT, MOOGO_BACKUP_BUCKET, MOOGO_BACKUP_ACCESS_KEY and
# MOOGO_BACKUP_SECRET_KEY; the service refuses to start if any of the four is
# missing. Everything else already has a sensible default.
#
# To fill the credentials in for R2:
#   1. Cloudflare dashboard -> R2 -> create a bucket.
#   2. R2 -> Manage API Tokens -> Create API Token, with Object Read & Write
#      on that bucket.
#   3. MOOGO_BACKUP_ENDPOINT is the S3 endpoint shown for the bucket, of the
#      form https://<account-id>.r2.cloudflarestorage.com
#   4. The token gives you an Access Key ID and a Secret Access Key.
#
# Leave the bucket private. Objects are stored unencrypted by Moogo and rely on
# the bucket's own access control, so a public bucket would expose every
# project database to anyone who can guess a key.
#
# MOOGO_BACKUP_ENABLED=false
# MOOGO_BACKUP_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# MOOGO_BACKUP_BUCKET=moogo-backups
# MOOGO_BACKUP_ACCESS_KEY=
# MOOGO_BACKUP_SECRET_KEY=
#
# SigV4 signing region. R2 ignores the value and accepts "auto"; other
# S3-compatible providers want their real region.
# MOOGO_BACKUP_REGION=auto
#
# Key prefix every backup object shares, namespaced per project below it.
# MOOGO_BACKUP_PREFIX=database-backups
#
# How often the scheduler looks for projects that are due.
# MOOGO_BACKUP_INTERVAL=15m
#
# How stale a backup may get before its project is backed up again. With the
# default this is once a day, and a project whose database has not changed
# since the last backup is skipped. Must be at least 24h: daily backups are
# keyed by date, so a shorter window could overwrite the same day's copy.
# MOOGO_BACKUP_MAX_AGE=24h
#
# How long a backup is kept before it is pruned. The newest backup of a project
# is always kept, so pruning never leaves a project with no restore point.
# MOOGO_BACKUP_RETENTION=720h
#
# How many projects one pass handles, so a backlog is worked through in
# bounded slices rather than all at once.
# MOOGO_BACKUP_BATCH_SIZE=20
#
# Ceiling on one project's snapshot-and-upload.
# MOOGO_BACKUP_TIMEOUT=15m
#
# How long a backup download link in a notification email stays valid. The link
# is single-use regardless; this is only how long an unused one stays live.
# MOOGO_BACKUP_DOWNLOAD_TTL=1h
#
# Where to POST a JSON alert when a project's backups keep failing, and how many
# consecutive failures it takes. The alert fires once at the threshold and once
# more when the project recovers. Leave the webhook unset to only expose the
# failure through the metrics below.
# MOOGO_BACKUP_ALERT_WEBHOOK=
# MOOGO_BACKUP_ALERT_AFTER=3
#
# The restore drill periodically re-downloads each project's newest backup and
# checks it end to end (checksum plus SQLite integrity_check), so a backup that
# cannot actually be restored is found before it is needed. These control how
# often it looks for work, how long a passing check is trusted, and how many
# projects one pass handles.
# MOOGO_BACKUP_VERIFY_INTERVAL=1h
# MOOGO_BACKUP_VERIFY_MAX_AGE=168h
# MOOGO_BACKUP_VERIFY_BATCH_SIZE=5
